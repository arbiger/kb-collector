# KB Collector Configuration

# Obsidian Vault Path
VAULT_PATH=/Users/george/Documents/Georges/Knowledge

# Default Author for notes (Who is running the tool)
NOTE_AUTHOR=George

# Local audio-to-text runtime (the only supported engine)
KB_WHISPER_ENGINE=mlx
MLX_WHISPER_BIN=/Users/george/venv-mlx-whisper/bin/mlx_whisper
MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# AI Provider (minimax or none)
# Set to 'none' when an agent supplies the summary with --summary.
AI_PROVIDER=none

# --- OPTIONAL: MiniMax API ---
# Required only when AI_PROVIDER=minimax.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# --- OPTIONAL: Extra Features ---
# Tavily API Key for Nightly Research
TAVILY_API_KEY=
# Email settings for reports
RECIPIENT_EMAIL=your-email@example.com
